{
  "name": "silly-stock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit --incremental false",
    "start": "next start",
    "lint": "eslint",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "smoke:production": "node scripts/smoke-production.mjs",
    "smoke:production:crud": "node scripts/smoke-production.mjs --crud"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "typescript": "^5"
  }
}
